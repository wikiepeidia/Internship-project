# Vietnamese Phishing Detection Pipeline - Environment Configuration Example
# Copy this to .env/APIKEY.json or .env/.env and fill with real values

# LLM Provider API Keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Optional: Override default similarity threshold for semantic deduplication
# SIMILARITY_THRESHOLD=0.85

# Optional: Override scrape delays (seconds)
# SCRAPE_DELAY_MIN=2.0
# SCRAPE_DELAY_MAX=5.0
